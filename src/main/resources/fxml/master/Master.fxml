<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<Group fx:id="root" stylesheets="@/css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="openconsignment.controller.master.MasterController">
    <VBox spacing="20.0" styleClass="screen">
        <VBox spacing="5.0">
            <Label text="DIRECTORY" styleClass="eyebrow" />
            <Label text="Master" styleClass="page-title" />
        </VBox>
        <HBox spacing="16.0" alignment="CENTER_LEFT">
            <Button fx:id="supplier_master_btn" text="Supplier Master" onAction="#showSupplierMaster" contentDisplay="TOP" graphicTextGap="12.0" prefWidth="200.0" prefHeight="160.0" styleClass="navigation-button">
                <graphic><ImageView fitHeight="64.0" fitWidth="80.0" preserveRatio="true"><image><Image url="@../../icons/SupplierMaster.png" /></image></ImageView></graphic>
            </Button>
            <Button fx:id="buyer_master_btn" text="Buyer Master" onAction="#showBuyerMaster" contentDisplay="TOP" graphicTextGap="12.0" prefWidth="200.0" prefHeight="160.0" styleClass="navigation-button">
                <graphic><ImageView fitHeight="64.0" fitWidth="80.0" preserveRatio="true"><image><Image url="@../../icons/BuyerMaster.png" /></image></ImageView></graphic>
            </Button>
            <Button fx:id="transport_master_btn" text="Transport Master" onAction="#showTransportMaster" contentDisplay="TOP" graphicTextGap="12.0" prefWidth="200.0" prefHeight="160.0" styleClass="navigation-button">
                <graphic><ImageView fitHeight="64.0" fitWidth="80.0" preserveRatio="true"><image><Image url="@../../icons/TransportMaster.png" /></image></ImageView></graphic>
            </Button>
        </HBox>
    </VBox>
</Group>
