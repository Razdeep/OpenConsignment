<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<Group stylesheets="@/css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="openconsignment.controller.master.SupplierController">
    <VBox prefWidth="717.0" prefHeight="540.0" spacing="20.0" styleClass="screen">
        <VBox spacing="5.0">
            <Label text="DIRECTORY" styleClass="eyebrow" />
            <Label text="Master Supplier" styleClass="page-title" />
        </VBox>
        <HBox spacing="24.0" VBox.vgrow="ALWAYS">
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                <Label text="Suppliers" styleClass="field-label" />
                <ListView fx:id="listView" prefWidth="320.0" VBox.vgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <Button fx:id="delete_btn" text="Delete" onAction="#deleteMaster" prefWidth="116.0" prefHeight="36.0" graphicTextGap="7.0" styleClass="danger-button">
                        <graphic><ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true"><image><Image url="@../../icons/MasterDelete.png" /></image></ImageView></graphic>
                    </Button>
                    <Button fx:id="refresh_btn" text="Refresh" onAction="#refreshList" prefWidth="116.0" prefHeight="36.0" graphicTextGap="7.0" styleClass="secondary-button">
                        <graphic><ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true"><image><Image url="@../../icons/Refresh.png" /></image></ImageView></graphic>
                    </Button>
                </HBox>
            </VBox>
            <VBox spacing="12.0" prefWidth="300.0" styleClass="surface">
                <Label text="Add supplier" styleClass="field-label" />
                <TextField fx:id="add_field" promptText="Enter supplier to add" />
                <Button fx:id="add_btn" text="Add" onAction="#addMaster" prefWidth="116.0" prefHeight="36.0" graphicTextGap="7.0" styleClass="primary-button">
                    <graphic><ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true"><image><Image url="@../../icons/MasterAdd.png" /></image></ImageView></graphic>
                </Button>
                <Label text="Rename selected supplier" styleClass="field-label" />
                <TextField fx:id="rename_field" promptText="Enter new supplier name" />
                <Button fx:id="rename_btn" text="Rename" onAction="#renameMaster" prefWidth="116.0" prefHeight="36.0" graphicTextGap="7.0" styleClass="secondary-button">
                    <graphic><ImageView fitHeight="20.0" fitWidth="20.0" preserveRatio="true"><image><Image url="@../../icons/MasterRename.png" /></image></ImageView></graphic>
                </Button>
            </VBox>
        </HBox>
    </VBox>
</Group>
