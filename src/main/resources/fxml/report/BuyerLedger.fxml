<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<Group fx:id="root" stylesheets="@/css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="openconsignment.controller.report.BuyerLedgerController">
    <VBox spacing="20.0" styleClass="screen">
        <VBox spacing="5.0">
            <Label text="REPORTING" styleClass="eyebrow" />
            <Label text="Buyer Ledger" styleClass="page-title" />
        </VBox>
        <VBox spacing="20.0" styleClass="surface">
        <VBox spacing="6.0">
            <Label text="Buyer" styleClass="field-label" />
            <ComboBox fx:id="buyer_name_combo" prefWidth="320.0" />
        </VBox>
        <HBox spacing="24.0">
            <RadioButton fx:id="buyer_ledger_radio" selected="true" text="Buyer Ledger"><toggleGroup><ToggleGroup fx:id="choice" /></toggleGroup></RadioButton>
            <RadioButton fx:id="agewise_outstanding_radio" text="Agewise Outstanding" toggleGroup="$choice" />
        </HBox>
        <HBox spacing="10.0">
            <Button fx:id="generate_pdf_btn" onAction="#generatePDF" text="Generate PDF Report" prefHeight="36.0" styleClass="primary-button" />
            <Button fx:id="launch_pdf_btn" onAction="#launchPdf" text="Launch PDF" prefHeight="36.0" styleClass="secondary-button" />
        </HBox>
        </VBox>
    </VBox>
</Group>
