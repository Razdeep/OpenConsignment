<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<Group fx:id="root" stylesheets="@/css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="openconsignment.controller.report.TransportLedgerController">
    <VBox spacing="20.0" styleClass="screen">
        <VBox spacing="5.0">
            <Label text="REPORTING" styleClass="eyebrow" />
            <Label text="Transport Ledger" styleClass="page-title" />
        </VBox>
        <VBox spacing="20.0" styleClass="surface">
        <VBox spacing="6.0">
            <Label text="Transport" styleClass="field-label" />
            <ComboBox fx:id="transport_name_combo" prefWidth="320.0" />
        </VBox>
        <CheckBox fx:id="all_time_checkbox" text="All Time" />
        <HBox spacing="16.0">
            <VBox spacing="6.0"><Label text="From" styleClass="field-label" /><DatePicker fx:id="from_date" prefWidth="160.0" /></VBox>
            <VBox spacing="6.0"><Label text="To" styleClass="field-label" /><DatePicker fx:id="to_date" prefWidth="160.0" /></VBox>
        </HBox>
        <HBox spacing="10.0">
            <Button fx:id="generate_pdf_report_btn" onAction="#generatePDF" text="Generate PDF Report" prefHeight="36.0" styleClass="primary-button" />
            <Button fx:id="launch_report_btn" onAction="#launchPdf" text="Launch PDF" prefHeight="36.0" styleClass="secondary-button" />
        </HBox>
        </VBox>
    </VBox>
</Group>
