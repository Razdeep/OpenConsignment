<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<Group fx:id="root" stylesheets="@/css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="openconsignment.controller.history.CollectionHistoryController">
    <VBox prefWidth="717.0" prefHeight="540.0" spacing="20.0" styleClass="screen">
        <VBox spacing="5.0">
            <Label text="HISTORY" styleClass="eyebrow" />
            <Label text="Collection History" styleClass="page-title" />
        </VBox>
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
            <columns>
                <TableColumn fx:id="voucher_no_col" prefWidth="120.0" text="Voucher No." />
                <TableColumn fx:id="voucher_date_col" prefWidth="130.0" text="Voucher Date" />
                <TableColumn fx:id="buyer_name_col" prefWidth="270.0" text="Buyer Name" />
                <TableColumn fx:id="total_amount_col" prefWidth="140.0" text="Total Amount" />
            </columns>
        </TableView>
    </VBox>
</Group>
