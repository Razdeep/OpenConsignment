<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<Group fx:id="root" stylesheets="@/css/main.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="openconsignment.controller.history.BillHistoryController">
    <VBox prefWidth="900.0" prefHeight="540.0" spacing="20.0" styleClass="screen">
        <VBox spacing="5.0">
            <Label text="HISTORY" styleClass="eyebrow" />
            <Label text="Bill History" styleClass="page-title" />
        </VBox>
        <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="supplier_name_col" prefWidth="150.0" text="Supplier Name" />
                <TableColumn fx:id="buyer_name_col" prefWidth="150.0" text="Buyer Name" />
                <TableColumn fx:id="bill_no_col" prefWidth="90.0" text="Bill No." />
                <TableColumn fx:id="bill_date_col" prefWidth="100.0" text="Bill Date" />
                <TableColumn fx:id="transport_col" prefWidth="120.0" text="Transport" />
                <TableColumn fx:id="lr_date_col" prefWidth="100.0" text="LR Date" />
                <TableColumn fx:id="bill_amount_col" prefWidth="120.0" text="Bill Amount" />
            </columns>
        </TableView>
    </VBox>
</Group>
