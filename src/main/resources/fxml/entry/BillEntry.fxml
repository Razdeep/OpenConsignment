<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.Group?>
<?import javafx.scene.text.*?>
<?import javafx.scene.layout.*?>

<Group xmlns:fx="http://javafx.com/fxml/1" fx:id="root" xmlns="http://javafx.com/javafx/8.0.111"
       fx:controller="openconsignment.controller.entry.BillEntryController" stylesheets="@/css/bills.css">
    <children>
        <AnchorPane minHeight="560.0" minWidth="660.0" prefHeight="600.0" prefWidth="717.0" styleClass="bill-entry" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
            <VBox spacing="16.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="24.0" AnchorPane.rightAnchor="24.0" AnchorPane.topAnchor="20.0">
                <VBox spacing="5.0">
                    <Label styleClass="bill-title" text="Bills" />
                </VBox>

                <GridPane hgap="24.0" vgap="14.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                    </columnConstraints>
                    <HBox alignment="BOTTOM_LEFT" spacing="10.0" GridPane.columnSpan="2" GridPane.rowIndex="0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="bill-field-label" text="Bill number" />
                            <TextField fx:id="bill_no_field" prefWidth="180.0" promptText="Enter bill number">
                                <font>
                                    <Font size="16.0" />
                                </font></TextField>
                        </VBox>
                        <Button mnemonicParsing="false" prefWidth="78.0" styleClass="bill-secondary-button" text="Fetch" onAction="#fetchBill" />
                        <Button mnemonicParsing="false" prefWidth="78.0" styleClass="bill-secondary-button" text="Print" />
                        <Button mnemonicParsing="false" prefWidth="78.0" styleClass="bill-danger-button" text="Delete" onAction="#deleteEntry"/>
                        <VBox minWidth="150.0" prefWidth="180.0" spacing="6.0">
                            <Label styleClass="bill-field-label" text="Bill date" />
                            <DatePicker fx:id="date_field" maxWidth="Infinity" promptText="Choose date" />
                        </VBox>
                    </HBox>
                    <VBox spacing="6.0" GridPane.rowIndex="1">
                        <Label styleClass="bill-field-label" text="Supplier" />
                        <TextField fx:id="supplier_field" promptText="Start typing a supplier name">
                            <font>
                                <Font size="16.0" />
                            </font></TextField>
                    </VBox>
                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label styleClass="bill-field-label" text="Buyer" />
                        <TextField fx:id="buyer_name_field" promptText="Start typing a buyer name">
                            <font>
                                <Font size="16.0" />
                            </font></TextField>
                    </VBox>
                    <VBox spacing="6.0" GridPane.rowIndex="2">
                        <Label styleClass="bill-field-label" text="Transport" />
                        <TextField fx:id="transport_field" promptText="Start typing a transport name">
                            <font>
                                <Font size="16.0" />
                            </font></TextField>
                    </VBox>
                    <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label styleClass="bill-field-label" text="LR date" />
                        <DatePicker fx:id="lr_date" maxWidth="Infinity" promptText="Choose date" />
                    </VBox>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="bill-field-label" text="LR number" />
                            <TextField fx:id="lr_field" prefWidth="180.0" promptText="Enter LR number">
                                <font>
                                    <Font size="16.0" />
                                </font></TextField>
                        </VBox>
                        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                            <Label styleClass="bill-field-label" text="PM" />
                            <TextField fx:id="pm_field" prefWidth="110.0" promptText="Enter PM">
                                <font>
                                    <Font size="16.0" />
                                </font></TextField>
                        </VBox>
                        <Button fx:id="add_btn" mnemonicParsing="false" onAction="#addToList" prefWidth="88.0" styleClass="bill-primary-button" text="Add LR" />
                        <Button fx:id="replace_btn" mnemonicParsing="false" onAction="#replaceInList" prefWidth="82.0" styleClass="bill-secondary-button" text="Replace" />
                        <Button fx:id="delete_btn" mnemonicParsing="false" onAction="#deleteFromList" prefWidth="82.0" styleClass="bill-danger-button" text="Remove" />
                    </HBox>
                    <TableView fx:id="lrTable" minHeight="100.0" prefHeight="170.0" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                        <placeholder>
                            <Label styleClass="bill-muted" text="Lorry receipts added to this bill will appear here" />
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="lr_no_col" prefWidth="400.0" text="LR number" />
                            <TableColumn fx:id="pm_col" prefWidth="220.0" text="PM" />
                        </columns>
                    </TableView>
                </VBox>

                <HBox alignment="BOTTOM_LEFT" spacing="12.0" styleClass="bill-footer">
                    <VBox spacing="6.0">
                        <Label styleClass="bill-field-label" text="Bill amount" />
                        <TextField fx:id="bill_amount_field" alignment="CENTER_RIGHT" prefWidth="180.0" promptText="0.00" styleClass="bill-amount-field">
                            <font>
                                <Font size="16.0" />
                            </font></TextField>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="clear_btn" mnemonicParsing="false" onAction="#clearAllFields" prefWidth="88.0" styleClass="bill-secondary-button" text="Clear" />
                    <Button fx:id="save_btn" mnemonicParsing="false" onAction="#save" prefWidth="110.0" styleClass="bill-primary-button" text="Save bill" />
                </HBox>
            </VBox>
        </AnchorPane>
    </children>
</Group>
